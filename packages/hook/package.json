{
  "name": "@emberline/hook",
  "license": "AGPL-3.0-or-later",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "emberline-hook: forwards Claude Code hook payloads to Emberline core; emberline-mcp serves the ticket_complete and preview tools.",
  "bin": {
    "emberline-hook": "./dist/main.js",
    "emberline-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "wrappers"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emberline/protocol": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.1.5"
  }
}
