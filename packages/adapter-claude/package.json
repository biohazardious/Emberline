  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Claude Code adapter: hook wiring, transcript and screen signal parsing.",
  "exports": {
    ".": {
      "@emberline/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emberline/adapter-sdk": "workspace:*",
    "@emberline/protocol": "workspace:*"
  }
}
