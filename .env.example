# Copy to .env and adjust. Used by compose.yaml.

# Interface/port the web UI binds to on the host. 127.0.0.1 keeps it local; 0.0.0.0 opens it to the LAN.
EMBERLINE_BIND=127.0.0.1
EMBERLINE_PORT=7420

# Optional: comma-separated host names you open Emberline by, when it is not an IP address or
# localhost (a reverse proxy, truenas.local). Other names get HTTP 421 (DNS-rebinding guard).
# `*` turns the check off.
EMBERLINE_ALLOWED_HOSTS=

# Time zone for both containers (IANA name). Claude prints usage-limit resets as wall-clock
# times ("resets 2pm"); the quota scheduler reads them in this zone. EMBERLINE_TIMEZONE overrides it for core.
TZ=UTC

# Optional: enables GET /metrics (Prometheus text format) for scrapers sending
# `Authorization: Bearer <token>`. Unset = the endpoint does not exist.
EMBERLINE_METRICS_TOKEN=

# Host ports for previews, published on EMBERLINE_BIND: the runner's range serves command previews
# (dev servers), the docker engine's range compose previews. Keep the two disjoint.
EMBERLINE_PREVIEW_PORTS_RUNNER=4300-4324
EMBERLINE_PREVIEW_PORTS_DOCKER=4325-4349

# Optional: an isolated Docker engine (rootless Docker-in-Docker, privileged; never the host's
# Docker socket) so agents can build and run containers and Emberline can preview compose projects.
# Enable both lines together (or run `make up-docker`); unset = no Docker. See SECURITY.md.
# COMPOSE_PROFILES=docker
# EMBERLINE_DOCKER_HOST=tcp://docker:2375

# Optional: give the runner a USB serial board (ESP32, Arduino, ...). See compose.usb.yaml.
# COMPOSE_FILE=compose.yaml:compose.usb.yaml
# EMBERLINE_SERIAL_DEVICE=/dev/ttyUSB0   # or /dev/ttyACM0; not a /dev/serial/by-id path
# EMBERLINE_SERIAL_GID=20
