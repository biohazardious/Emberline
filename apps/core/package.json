{
  "name": "@emberline/core",
  "license": "AGPL-3.0-or-later",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Emberline core: API, board, scheduler and git layer.",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/emit-browser-files.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=@emberline/source src/main.ts",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@emberline/adapter-claude": "workspace:*",
    "@emberline/adapter-codex": "workspace:*",
    "@emberline/adapter-gemini": "workspace:*",
    "@emberline/adapter-sdk": "workspace:*",
    "@emberline/protocol": "workspace:*",
    "@emberline/ptyd": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.2.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.6",
    "ssh2": "^1.16.0",
    "yaml": "2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "ws": "^8.18.3"
  }
}
