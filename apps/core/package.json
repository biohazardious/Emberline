{
  "name": "@emberline/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Emberline core: API, board, scheduler and git layer.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=@emberline/source src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@emberline/protocol": "workspace:*",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0"
  }
}
